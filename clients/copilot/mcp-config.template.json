{
    "mcpServers": {
        "__SERVER_NAME__": {
            "type": "stdio",
            "command": "npx",
            "tools": [
                "*"
            ],
            "args": [
                "-y",
                "__MCP_PACKAGE__",
                "__ORG__",
                "--authentication",
                "pat"
            ],
            "env": {
                "AZURE_DEVOPS_ORG_URL": "__ORG_URL__",
                "PERSONAL_ACCESS_TOKEN": "__PAT_B64__"
            }
        }
    }
}
